{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeTheStageFunction",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:${region}:${account_id}:function:ecp-batch-stage",
        "arn:aws:lambda:${region}:${account_id}:function:ecp-batch-stage:*"
      ]
    },
    {
      "Sid": "RunThePipelineTaskInTheBatchCluster",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:${region}:${account_id}:task-definition/ecp-batch-pipeline:*",
      "Condition": {
        "ArnEquals": { "ecs:cluster": "arn:aws:ecs:${region}:${account_id}:cluster/ecp-batch" }
      }
    },
    {
      "Sid": "WaitForTheTask",
      "Effect": "Allow",
      "Action": ["ecs:DescribeTasks", "ecs:StopTask"],
      "Resource": "arn:aws:ecs:${region}:${account_id}:task/ecp-batch/*"
    },
    {
      "Sid": "SyncIntegrationRule",
      "Effect": "Allow",
      "Action": ["events:PutTargets", "events:PutRule", "events:DescribeRule"],
      "Resource": "arn:aws:events:${region}:${account_id}:rule/StepFunctionsGetEventsForECSTaskRule"
    },
    {
      "Sid": "PassOnlyTheTaskRolesToEcs",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::${account_id}:role/ecp-batch-exec",
        "arn:aws:iam::${account_id}:role/ecp-batch-task"
      ],
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
