{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StageOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::ecp-data-${account_id}-${region}/store/staging/*"
    },
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/ecp-batch-stage:*"
    }
  ]
}
