# Copy to backend.hcl (git-ignored), then: terraform init -backend-config=backend.hcl
# The member account's state bucket (infra/bootstrap, member instance).
bucket       = "ecp-tfstate-<member-account-id>-ca-central-1"
key          = "batch/terraform.tfstate"
region       = "ca-central-1"
encrypt      = true
use_lockfile = true
