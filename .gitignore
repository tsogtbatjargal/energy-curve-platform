# Secrets and credentials: never commit
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
*.tfvars
!*.tfvars.example

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
tfplan
*.tfplan
plan.json

# Local data and test artifacts
data/
spark-warehouse/
metastore_db/
derby.log
test-results/
playwright-report/

# Backend config contains the account ID (the bucket name). One file per instance of a stack,
# e.g. infra/bootstrap/backend-member.hcl (ADR-0021 phase 3).
backend.hcl
backend*.hcl
# Per-instance Terraform data directories (TF_DATA_DIR), e.g. .terraform-member/
.terraform-*/

# Local db-backup output (may contain real alert history)
backups/
